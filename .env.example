# Mercado Libre API Configuration
# Get your credentials from https://global-selling.mercadolibre.com/devcenter
MERCADO_LIBRE_CLIENT_ID=your_client_id_here
MERCADO_LIBRE_CLIENT_SECRET=your_client_secret_here
MERCADO_LIBRE_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Set to 'false' to use real API, 'true' for mock demo data
MERCADO_LIBRE_MOCK=true
